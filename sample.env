# ASR core runtime options
# base model/cache root (project-relative)
WHISPER_MODEL_DIR='./models'

# backend: ct2 | hf_generate | hf_pipeline | qwen_transformers
ASRFLOW_STT_BACKEND='qwen_transformers'

# model alias or HF id
ASRFLOW_STT_MODEL='Qwen/Qwen3-ASR-0.6B'

# explicit local model directory (optional)
# ASRFLOW_STT_MODEL_PATH=

# device: auto | cuda | cpu
ASRFLOW_STT_DEVICE='auto'

# fp16 preference
ASRFLOW_STT_FP16='true'

# language: auto/none for auto-detect, or fixed language code like ko/en
ASRFLOW_STT_LANGUAGE='auto'

# task: transcribe | translate
ASRFLOW_STT_TASK='transcribe'

# ct2 beam size
ASRFLOW_STT_BEAM_SIZE='5'

# decode temperature (0.0 = deterministic)
ASRFLOW_STT_TEMPERATURE='0.0'

# ct2 backend VAD filter
ASRFLOW_STT_CT2_VAD_FILTER='false'
ASRFLOW_STT_MAX_NEW_TOKENS='256'
ASRFLOW_STT_MAX_INFERENCE_BATCH_SIZE='8'

# worker/mic defaults
ASRFLOW_STT_CHUNK_SEC='3.0'
ASRFLOW_STT_SAMPLERATE='16000'

# native stream example defaults (Qwen ASR transformers native stream)
ASRFLOW_STREAM_MODEL='Qwen/Qwen3-ASR-0.6B'
# ASRFLOW_STREAM_MODEL_PATH=
ASRFLOW_STREAM_LANGUAGE='auto'
ASRFLOW_STREAM_CHUNK_SEC='2.0'
ASRFLOW_STREAM_SAMPLERATE='16000'
ASRFLOW_STREAM_MAX_NEW_TOKENS='512'
ASRFLOW_STREAM_UNFIXED_CHUNK_NUM='2'
ASRFLOW_STREAM_UNFIXED_TOKEN_NUM='5'
NF_ASR_STREAM_ENABLED='true'

# CamHub server (NFCP TCP)
NF_CAMHUB_HOST='0.0.0.0'
NF_CAMHUB_PORT='26200'
NF_CAMHUB_CLIENT_NAME='cam0'
NF_CAMHUB_CLIENT_FPS='10'
NF_CAMHUB_CLIENT_QUALITY='80'

NF_ASR_SERVER_HOST='0.0.0.0'
NF_ASR_SERVER_PORT='26100'
AUDIOMI_HOST='127.0.0.1'
AUDIOMI_PORT='26070'
AUDIOMI_CHECKCODE='20250918'
ENABLE_LOGGING=false

# ------------------------------
# NeuroFlow integrated demo (main.py)
# ------------------------------
# Unified A/V device path
# - set once, camera uses this path directly
DEVICE_PATH='\?\usb#vid_1bcf&pid_2284&mi_00#b&2f4f0816&0&0000#{e5323777-f976-4f5b-9b55-b94699c46e44}\global'

# Camera selection (DEVICE_PATH 우선, 없거나 매칭 실패 시 CAMERA_ID 사용)
CAMERA_ID='0'
#CAMERA_DEVICE_PATH=\\?\usb#vid_1bcf&pid_28c4&mi_00#b&1da11eb4&0&0000#{65e8773d-8f56-11d0-a3b9-00a0c9223196}\global
# Resolution: single source of truth (WxH)
# ex) 640x480 / 1280x720 / 1920x1080
# Higher resolution lowers FPS when face+pose are both enabled.
CAMERA_RESOLUTION='640x480'
# Top camera viewport ratio (0.35 ~ 0.75, default 0.52)
CAMERA_TOP_RATIO='0.52'
CAMERA_USE_DSHOW='true'

# Detection counts
MAX_FACE='1'
MAX_POSE='1'

# Microphone selection for webcam mic
# - index only (sounddevice input index)
# - if empty/invalid, default input device is used
MIC_DEVICE='0'
MIC_SAMPLERATE='16000'
MIC_BLOCKSIZE='1024'

# Optional model path overrides for vision workers
FACE_MODEL_PATH='models/blaze_face_short_range.tflite'
FACE_LANDMARK_MODEL_PATH='models/face_landmarker.task'
POSE_MODEL_PATH='models/pose_landmarker_lite.task'

# Accumulate ASR tuning
ASR_STEP_S='1.5'
ASR_MAX_WINDOW_S='25'
